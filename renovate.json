{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>RevenueCat/renovate"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "com.google.android.gms:play-services-ads",
        "com.google.android.libraries.ads.mobile.sdk:ads-mobile-sdk"
      ],
      "matchManagers": [
        "gradle"
      ],
      "enabled": true,
      "groupName": "google-mobile-ads"
    },
    {
      "description": "Keep the explicitly supported Next-Gen minimum version stable",
      "matchPackageNames": [
        "com.google.android.libraries.ads.mobile.sdk:ads-mobile-sdk"
      ],
      "matchManagers": [
        "gradle"
      ],
      "matchCurrentVersion": "1.3.0",
      "enabled": false
    },
    {
      "matchFileNames": [
        "test-apps/admob-legacy-compatibility/**"
      ],
      "matchPackageNames": [
        "com.google.android.gms:play-services-ads"
      ],
      "matchManagers": [
        "gradle"
      ],
      "enabled": true,
      "groupName": "google-mobile-ads-legacy-compatibility"
    },
    {
      "description": "The shared preset only opts in the revenuecat orb; keep the Android orb current too",
      "matchManagers": [
        "circleci"
      ],
      "matchDatasources": [
        "orb"
      ],
      "matchPackageNames": [
        "circleci/android"
      ],
      "enabled": true,
      "groupName": "circleci-orb"
    },
    {
      "description": "Ship the CI image bump in the same PR as the orb bumps",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "cimg/android"
      ],
      "enabled": true,
      "groupName": "circleci-orb"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "cimg/android tag passed to the android orb's docker executor; the circleci manager only sees plain `docker: image:` entries",
      "managerFilePatterns": [
        "/^\\.circleci/config\\.yml$/"
      ],
      "matchStrings": [
        "name: android/android_docker\\n(?:[ \\t]+resource_class: [^\\n]*\\n)?[ \\t]+tag: (?<currentValue>\\d{4}\\.\\d{2}\\.\\d+)"
      ],
      "depNameTemplate": "cimg/android",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{2})\\.(?<patch>\\d+)$"
    }
  ]
}
